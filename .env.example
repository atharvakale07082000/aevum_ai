# Copy to .env and fill in AEVUM_AI_NVIDIA_API_KEY.
#
# Everything here is optional. With no model provider at all the service still
# answers every panel: the figures are identical, the prose comes from templates,
# and the response says `source: "deterministic"` so the interface can tell the
# reader which it got. Degraded, never wrong.
#
# Read once at startup through src/aevum_ai/config.py. Every variable takes the
# AEVUM_AI_ prefix, so this file cannot collide with the ai-tutor backend's own
# environment if both are sourced in one shell.

# ── The Aevum backend ─────────────────────────────────────────────────────────
# This service is a client of the REST API and holds no credentials of its own:
# it reads each decision back out as whoever called it, using the bearer token
# and X-Organization-Id from the inbound request. A service account would be a
# second path into tenant data sitting outside TenantFilter.
AEVUM_AI_API_BASE_URL=http://localhost:8080

# ── NVIDIA NIM ────────────────────────────────────────────────────────────────
# nvidia | anthropic | bedrock | none
AEVUM_AI_MODEL_PROVIDER=nvidia

# The same key the ai-tutor backend uses (its NVIDIA_API_KEY). One key, both
# services. Get one at https://build.nvidia.com — the free tier is enough.
AEVUM_AI_NVIDIA_API_KEY=
AEVUM_AI_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Do not swap this casually. Every job in this service asks the agent for
# STRUCTURED OUTPUT — a typed narrative, never free text. The ai-tutor backend
# found that models which chat perfectly well can still fail Strands' structured
# output and degrade silently rather than raising, and that a chain-of-thought
# model will spend the whole token budget deliberating and return nothing.
# Validate a replacement against a real panel call, not against a prompt.
AEVUM_AI_NIM_MODEL=nvidia/nemotron-3-super-120b-a12b

# NVIDIA's free tier is 40 requests/minute. Enforced by a sliding-window bucket
# in nim.py: without it, opening one decision room fires four generations at
# once and a busy afternoon returns 429 on all four, which reads as the product
# being broken rather than as a quota.
AEVUM_AI_NIM_RPM_LIMIT=40
AEVUM_AI_NIM_MAX_CONCURRENCY=4

# 3000, not 1200. A reasoning model spends tokens before the visible answer, and
# running out mid-turn fails the whole request instead of shortening it.
AEVUM_AI_MAX_TOKENS=3000
AEVUM_AI_TEMPERATURE=0.2

# ── Alternate providers ───────────────────────────────────────────────────────
# Only read when AEVUM_AI_MODEL_PROVIDER is set to one of these.
AEVUM_AI_ANTHROPIC_API_KEY=
AEVUM_AI_MODEL_ID=claude-sonnet-4-6
AEVUM_AI_BEDROCK_REGION=us-west-2

# ── Service ───────────────────────────────────────────────────────────────────
AEVUM_AI_PORT=8090
# Only needed for direct browser calls. In the normal setup the browser never
# reaches this service: the Next app proxies it at /api/ai and attaches the
# token from an httpOnly cookie.
AEVUM_AI_CORS_ORIGIN=http://localhost:3000
AEVUM_AI_REQUEST_TIMEOUT_SECONDS=20
